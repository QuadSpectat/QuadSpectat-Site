# In dev, Vite proxies /api → localhost:3001 so this isn't needed.
# Set it for production builds pointing at a deployed backend.
# VITE_API_URL=https://api.yourdomain.com/api

# Google Maps Platform API key — only for the owner-only "Google 3D" basemap
# (shown in /app only; share and client links never offer it, and measuring is
# disabled while it is on, per Google's terms).
# Enable "Map Tiles API" at https://console.cloud.google.com
# WARNING: any VITE_ variable is compiled into the public JS bundle, so this key
# is visible to everyone who loads the site. Before setting it:
#   - Restrict it: Application restriction = HTTP referrers (only the owner's
#     domains, e.g. https://quadspectat.com/*), API restriction = Map Tiles API only.
#   - Set a budget with alerts and a daily quota cap on Map Tiles API
#     (Google bills per session).
# Leave unset in production unless you want the option live: the button then shows
# a short notice and falls back to the previous base map.
# VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
