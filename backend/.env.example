PORT=3001

# SQLite data directory (optional)
# In local dev, backend defaults to ./backend/data/viewer.db if omitted.
# DATA_DIR=E:/AI Project - 3D Model Viewer 2026/backend/data

# Optional admin login
ADMIN_USERNAME=admin
# Generate with:
# node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-me

# Public model label visible to anonymous users
PUBLIC_ASSET_NAME=DEMO

# DigitalOcean Spaces (S3-compatible)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=quadspectat-models
SPACES_REGION=fra1
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# Presigned URL TTL in seconds (default 1 hour)
PRESIGN_EXPIRY_SECONDS=3600
